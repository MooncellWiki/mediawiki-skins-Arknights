{{!
	array array-link-columns[ {label, array-items[ {html} ]} ] (MediaWiki:Arknights-footer-links, FooterLinksParser)
	object data-places { id, className, array-items[ {id, html} ] }
	object data-icons  { id, className, array-items[ {id, html} ] }
	string html-footer-desc / html-footer-tagline (MediaWiki:Arknights-footer-desc / -tagline)
	string msg-sitetitle / msg-arknights-footer-powered / msg-arknights-footer-about
	string|null html-header-tagline

	DOM contract of chrome/footer.css:
	  .ak-footer__inner > .ak-footer__brand (span.ak-header__wordmark + p) + .ak-footer__col* (h4 + ul) + .ak-footer__col (h4 + ul#footer-places)
	  (the brand takes the explicit 1.4fr column, every .ak-footer__col an implicit 1fr one — column count follows content)
	  .ak-footer__bottom > .ak-footer__bottom-text + ul.ak-footer__icons#footer-icons
	  span.ak-watermark
	Core strips data-footer.* down to array-items[{id, html}], so the lists are written out
	item by item (see the docs site, /guide/skin-template#页脚数据).
}}
<footer class="ak-footer mw-footer" id="footer"{{{html-user-language-attributes}}}>
	<div class="ak-footer__inner">
		<div class="ak-footer__brand">
			<span class="ak-header__wordmark mw-wiki-title">{{msg-sitetitle}}{{#html-header-tagline}}<small>{{.}}</small>{{/html-header-tagline}}</span>
			{{#html-footer-desc}}<div class="ak-footer__desc" id="footer-desc">{{{.}}}</div>{{/html-footer-desc}}
		</div>
		{{#array-link-columns}}
		<nav class="ak-footer__col" aria-label="{{label}}">
			<h4>{{label}}</h4>
			<ul>{{#array-items}}<li>{{{html}}}</li>{{/array-items}}</ul>
		</nav>
		{{/array-link-columns}}
		{{#data-places}}
		<nav class="ak-footer__col{{#className}} {{.}}{{/className}}" aria-label="{{msg-arknights-footer-about}}">
			<h4>{{msg-arknights-footer-about}}</h4>
			<ul id="{{id}}">{{#array-items}}<li id="{{id}}">{{{html}}}</li>{{/array-items}}</ul>
		</nav>
		{{/data-places}}
	</div>
	<div class="ak-footer__bottom">
		<div class="ak-footer__bottom-text">
			{{#html-footer-tagline}}<span id="footer-tagline">{{{.}}}</span>{{/html-footer-tagline}}
			<span class="ak-en">{{msg-arknights-footer-powered}}</span>
		</div>
		{{#data-icons}}
		<ul class="ak-footer__icons{{#className}} {{.}}{{/className}}" id="{{id}}">{{#array-items}}<li id="{{id}}">{{{html}}}</li>{{/array-items}}</ul>
		{{/data-icons}}
	</div>
	<span class="ak-watermark" aria-hidden="true">{{msg-sitetitle}}</span>
</footer>
