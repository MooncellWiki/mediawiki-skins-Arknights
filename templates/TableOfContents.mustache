{{!
	object data-toc  core TOC data enriched by ArknightsComponentTableOfContents
	string msg-toc / msg-arknights-back-to-top
}}
{{#data-toc}}
{{! First row of the flyout (< 1400px only, where .ak-fab is hidden) }}
<a class="ak-toc__top" href="#"><span class="ak-icon ak-icon--collapse"></span>{{msg-arknights-back-to-top}}</a>
<nav class="ak-toc__inner{{#is-collapse-sections-enabled}} ak-toc--collapse-enabled{{/is-collapse-sections-enabled}}" id="mw-panel-toc" aria-labelledby="ak-toc-label">
	<div class="ak-toc__title" id="ak-toc-label">{{msg-toc}}</div>
	<div class="ak-toc__progress" aria-hidden="true"><i></i></div>
	{{>TableOfContents__list}}
</nav>
{{/data-toc}}
