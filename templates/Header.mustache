{{!
	string msg-arknights-drawer-toggle / msg-toc
	string msg-arknights-appearance / msg-arknights-nav-screen
	object data-search-box   core search box data
	bool has-theme-toggle
	bool toc-enabled
	object data-user-menu

	The main row carries no site navigation: that lives in the sidebar only (MediaWiki:MenuSidebar
	or the MediaWiki:Sidebar portlets), which is reachable at every width — as a column at ≥ 1120px
	and as the drawer opened from the local nav below it.
}}
<header class="ak-header mw-header" id="mw-head">
	<div class="ak-header__inner">
		{{>Header__logo}}
		{{#data-search-box}}{{>Search}}{{/data-search-box}}
		{{!
			Phones (< 640): search collapses to this icon, which opens the palette.
			With the palette off, search.js falls back to revealing #searchform in place —
			hence both aria-haspopup and the aria-controls/-expanded pair.
		}}
		<button type="button" class="ak-header__search-toggle ak-icon-btn" id="ak-search-toggle" aria-label="{{msg-arknights-search-toggle}}" title="{{msg-arknights-search-toggle}}" aria-haspopup="dialog" aria-controls="searchform" aria-expanded="false">
			<span class="ak-icon ak-icon--search"></span>
		</button>
		{{!
			Below 1120px the tools (theme toggle, notifications, user menu) collapse into the card
			pulled down by the burger; above it .ak-header__screen is display:contents, so they take
			part in the main row's grid directly. One DOM either way — the Echo and #p-personal ids
			are never duplicated.

			Opening the card is pure CSS, so it works without JS: the checkbox has to precede both
			the card and the label for `~` to reach them. header.js only adds Escape, outside
			clicks and closing again on the way back to desktop widths.
		}}
		<input type="checkbox" id="ak-nav-toggle" class="ak-nav-cb" aria-controls="ak-nav-screen">
		<div class="ak-header__screen" id="ak-nav-screen">
			<div class="ak-header__tools">
				{{#has-theme-toggle}}
				<div class="ak-header__tool">
					<span class="ak-header__tool-label">{{msg-arknights-appearance}}</span>
					{{>ThemeToggle}}
				</div>
				{{/has-theme-toggle}}
				{{#data-user-menu}}{{>UserMenu}}{{/data-user-menu}}
			</div>
		</div>
		<label class="ak-header__burger" for="ak-nav-toggle">
			<span class="ak-header__burger-icon" aria-hidden="true"><i></i><i></i><i></i></span>
			<span class="ak-sr-only">{{msg-arknights-nav-screen}}</span>
		</label>
	</div>
	{{!
		Local nav — the header's second row, shown by CSS below 1400px only.
		It stays pinned once the main row scrolls away, so the drawer and the table of
		contents are reachable at any scroll position without a floating corner button.
		The TOC flyout is opened by the checkbox below (pure CSS, works without JS).
	}}
	<div class="ak-local-nav">
		<button type="button" class="ak-local-nav__btn ak-local-nav__menu" id="ak-drawer-toggle" aria-controls="ak-sidebar" aria-expanded="false">
			<span class="ak-icon ak-icon--menu"></span>{{msg-arknights-drawer-toggle}}
		</button>
		{{#toc-enabled}}
		<input type="checkbox" id="ak-toc-toggle" class="ak-toc-cb" aria-controls="ak-toc">
		<label class="ak-local-nav__btn ak-local-nav__toc" for="ak-toc-toggle">{{msg-toc}}<span class="ak-local-nav__chevron" aria-hidden="true"></span></label>
		{{/toc-enabled}}
	</div>
</header>
