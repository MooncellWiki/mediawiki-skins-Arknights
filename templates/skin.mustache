{{!
	Arknights skin — root template.

	string|null html-site-notice   MediaWiki:Sitenotice (wrapped in #siteNotice by core)
	string html-body-content       #mw-content-text.mw-body-content + printfooter
	string html-after-content      SkinAfterContent hook output
	string html-user-message       "You have new messages" banner
	string html-undelete-link
	bool toc-enabled               whether the sticky table of contents is rendered
	bool is-mainpage-view          main page in view action
	object data-main-menu / data-menu-sidebar / data-user-menu /
	       data-page-heading / data-page-tools / data-toc / data-page-footer / data-footer
}}
<a class="ak-skip mw-jump-link" href="#bodyContent">{{msg-arknights-jumptocontent}}</a>
{{>Header}}
<div class="ak-page">
	{{#html-site-notice}}<div class="ak-sitenotice">{{{.}}}</div>{{/html-site-notice}}
	<div class="ak-layout{{^toc-enabled}} ak-layout--no-toc{{/toc-enabled}}{{#is-mainpage-view}} ak-layout--mainpage{{/is-mainpage-view}}">
		{{>Sidebar}}
		<main class="ak-main mw-body" id="content">
			{{>PageHeader}}
			{{!
				The table of contents belongs to the page, so it sits right after the heading:
				≥ 1400px CSS lifts it into the rail reserved by .ak-main's right padding,
				below that it becomes the flyout pulled down from the local nav. One DOM, two shapes.
			}}
			{{#toc-enabled}}
			<aside class="ak-toc" id="ak-toc" aria-label="{{msg-toc}}">
				{{>TableOfContents}}
			</aside>
			{{/toc-enabled}}
			<div class="ak-body{{#is-mainpage-view}} ak-body--mainpage{{/is-mainpage-view}}" id="bodyContent">
				{{#html-user-message}}{{{.}}}{{/html-user-message}}
				{{#html-undelete-link}}<div id="contentSub2">{{{.}}}</div>{{/html-undelete-link}}
				{{{html-body-content}}}
				{{{html-after-content}}}
			</div>
			{{>PageFooter}}
		</main>
	</div>
</div>
{{#data-footer}}{{>Footer}}{{/data-footer}}
{{! Back to top: hidden below 1400px, where the TOC flyout carries the same link instead }}
<button type="button" class="ak-fab ak-back-to-top" id="ak-back-to-top" aria-label="{{msg-arknights-back-to-top}}" title="{{msg-arknights-back-to-top}}" hidden><span class="ak-icon ak-icon--collapse"></span></button>
