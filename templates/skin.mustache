{{!
	Arknights skin — root template.

	string|null html-site-notice   MediaWiki:Sitenotice (wrapped in #siteNotice by core)
	string html-body-content       #mw-content-text.mw-body-content + printfooter
	string html-after-content      SkinAfterContent hook output
	string html-user-message       "You have new messages" banner
	string html-undelete-link
	bool toc-enabled               whether the sticky table of contents is rendered
	bool is-mainpage-view          main page in view action
	string html-categories         #catlinks (after the article paper, inside .ak-main__inner)
	object data-main-menu / data-menu-sidebar / data-user-menu /
	       data-page-heading / data-page-tools / data-toc / data-page-footer / data-footer

	DOM follows prts-design's chrome/ layer (docs site /guide/skin-template):
	  body > a.ak-skip + header.ak-header + .ak-keyart + .ak-page > .ak-layout > aside.ak-sidebar + main.ak-main > .ak-main__inner
	       > [.ak-sitenotice] + header.ak-page-header + .ak-toc-dock(aside.ak-toc) + .ak-body(#bodyContent) + #catlinks; footer.ak-footer; button.ak-fab
}}
{{>IconSprite}}
<a class="ak-skip mw-jump-link" href="#bodyContent">{{msg-arknights-jumptocontent}}</a>
{{>Header}}
{{!
	Key art — always emitted; an event theme (a gadget, or MediaWiki:Common.css) sets
	--ak-keyart-image and a height to show it. It sits behind the header glass and the layout
	and takes no room of its own (--ak-keyart-reveal is 0 by default): the sidebar / heading /
	TOC start right under the header, over the image. See design-system/tokens.css §2d and
	the README.
	A theme that puts readable content in __inner should drop the aria-hidden.
}}
<div class="ak-keyart" aria-hidden="true"><div class="ak-keyart__inner"></div></div>
<div class="ak-page">
	<div class="ak-layout{{^toc-enabled}} ak-layout--no-toc{{/toc-enabled}}{{#is-mainpage-view}} ak-layout--mainpage{{/is-mainpage-view}}">
		{{>Sidebar}}
		<main class="ak-main mw-body" id="content">
			<div class="ak-main__inner">
			{{!
				The site notice sits in the content column (as in Vector 2022), not across the
				page above the layout: nothing but the header may come before .ak-layout, or the
				sidebar starts lower than where it sticks — its max-height is the viewport minus
				that sticky offset, so its bottom would be off screen until the page is scrolled.
			}}
			{{#html-site-notice}}<div class="ak-sitenotice">{{{.}}}</div>{{/html-site-notice}}
			{{>PageHeader}}
			{{!
				The table of contents belongs to the page, so it sits right after the heading:
				≥ 1400px CSS lifts it into the rail reserved by .ak-main's right padding. From
				640px up to that it folds into a button of its own (the label — the same square as the
				back-to-top button, in the same column) with the list as a flyout under it. The
				dock is a zero-height sticky anchor: the button rests on the top right corner of
				the article, flush with its top edge, and follows the header once that is
				scrolled past, like the pinned TOC button in Vector 2022. On phones (≤ 639px)
				the button is hidden: the entry is the label in the header's local nav
				(Header.mustache), toggling this same checkbox, and the flyout hangs off the
				header. One DOM, three shapes.

				Checkbox, label and flyout are siblings, so opening it is pure CSS
				(:checked ~) and works without JS; toc.js adds the rest. The label is the icon
				alone: the name is the checkbox's aria-label, the tooltip the label's title.
			}}
			{{#toc-enabled}}
			<div class="ak-toc-dock">
				<input type="checkbox" id="ak-toc-toggle" class="ak-toc-cb" aria-label="{{msg-toc}}" aria-controls="ak-toc">
				<label class="ak-toc-btn" for="ak-toc-toggle" title="{{msg-toc}}"></label>
				<aside class="ak-toc" id="ak-toc" aria-label="{{msg-toc}}">
					{{>TableOfContents}}
				</aside>
			</div>
			{{/toc-enabled}}
			<div class="ak-body{{#is-mainpage-view}} ak-body--flat{{/is-mainpage-view}}" id="bodyContent">
				{{#html-user-message}}{{{.}}}{{/html-user-message}}
				{{#html-undelete-link}}<div id="contentSub2" class="ak-page-header__sub">{{{.}}}</div>{{/html-undelete-link}}
				{{{html-body-content}}}
				{{{html-after-content}}}
				{{>PageFooter}}
			</div>
			{{{html-categories}}}
			</div>
		</main>
	</div>
</div>
{{#data-footer}}{{>Footer}}{{/data-footer}}
{{! Back to top: hidden below 1120px (and while the TOC flyout is open), where the flyout carries the same link instead }}
<button type="button" class="ak-fab ak-back-to-top" id="ak-back-to-top" aria-label="{{msg-arknights-back-to-top}}" title="{{msg-arknights-back-to-top}}" hidden><span class="ak-icon ak-icon--collapse"></span></button>
