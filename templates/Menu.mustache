{{!
	A MediaWiki portlet (Skin::getPortletData()).
	string id / class / label / label-class / html-tooltip
	string html-before-portal / html-items / html-after-portal
}}
<nav id="{{id}}" class="ak-menu-portlet{{#class}} {{.}}{{/class}}"{{#label}} aria-label="{{.}}"{{/label}}{{{html-tooltip}}}{{{html-user-language-attributes}}}>
	{{#label}}<div class="ak-menu-portlet__heading ak-portlet__title{{#label-class}} {{.}}{{/label-class}}">{{.}}</div>{{/label}}
	<div class="ak-menu-portlet__content">
		{{{html-before-portal}}}
		<ul class="ak-menu-portlet__list">{{{html-items}}}</ul>
		{{{html-after-portal}}}
	</div>
</nav>
