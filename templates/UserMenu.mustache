{{!
	object data-notifications  Echo badges portlet (id p-notifications)
	object data-user-menu      personal tools portlet (id p-personal)
	object data-user-interface-preferences
	bool is-registered / is-anon
	string username / label / msg-toggle

	DOM contract of chrome/header.css (+ components/dropdown.css):
	  .ak-dropdown.ak-header__user-menu > details > summary.ak-btn.ak-btn--ghost.ak-header__user
	                                              + .ak-menu.ak-menu--right.ak-header__user-card
	                                                  > .ak-menu__head + nav.ak-menu__group#p-user-interface-preferences + nav.ak-menu__group#p-personal
}}
{{#data-notifications}}
<div class="ak-header__notifications" id="{{id}}"{{{html-tooltip}}}>
	<ul>{{{html-items}}}</ul>
</div>
{{/data-notifications}}
<div class="ak-dropdown ak-header__user-menu" id="ak-user-menu">
	<details>
		<summary class="ak-btn ak-btn--ghost ak-header__user" title="{{msg-toggle}}" aria-label="{{msg-toggle}}">
			<span class="ak-icon ak-icon--userAvatar"></span>
			<span class="ak-header__user-name">{{label}}</span>
		</summary>
		<div class="ak-menu ak-menu--right ak-header__user-card">
			{{#is-registered}}<div class="ak-menu__head"><span class="ak-icon ak-icon--userAvatar"></span>{{username}}</div>{{/is-registered}}
			{{#data-user-interface-preferences}}{{>MenuGroup}}{{/data-user-interface-preferences}}
			{{#data-user-menu}}{{>MenuGroup}}{{/data-user-menu}}
		</div>
	</details>
</div>
