{{!
	object data-menu-sidebar  { html-menu, html-after, label } — wikitext MediaWiki:MenuSidebar
	object data-main-menu     { array-portlets, data-site-tools, data-languages }

	DOM contract of chrome/sidebar.css: aside.ak-sidebar > .ak-sidebar__panel#mw-panel > (nav#MenuSidebar | nav.ak-portlet …).
	The head (title + close button) only shows in the < 1120px drawer (chrome/responsive.css).

	The toolbox is not here any more: it lives in the title row's "more" card. What is left
	is #p-site-tools (特殊页面 / 上传文件), rendered untitled straight after the navigation so
	it reads as a continuation of the last group rather than a section of its own.
}}
<aside class="ak-sidebar" id="ak-sidebar" aria-label="{{msg-arknights-sidebar-label}}" tabindex="-1">
	<div class="ak-sidebar__head">
		<span class="ak-sidebar__title">{{msg-navigation-heading}}</span>
		<button type="button" class="ak-btn ak-btn--icon ak-sidebar__close" aria-label="{{msg-arknights-drawer-close}}" title="{{msg-arknights-drawer-close}}"><span class="ak-icon ak-icon--close"></span></button>
	</div>
	<div class="ak-sidebar__panel" id="mw-panel">
		{{#data-menu-sidebar}}
		<nav id="MenuSidebar" class="ak-menusidebar" aria-label="{{label}}">{{{html-menu}}}</nav>
		{{/data-menu-sidebar}}
		{{#data-main-menu}}
		{{#array-portlets}}{{>Portlet}}{{/array-portlets}}
		{{#data-site-tools}}{{>Portlet}}{{/data-site-tools}}
		{{#data-languages}}{{>Portlet}}{{/data-languages}}
		{{/data-main-menu}}
		{{#data-menu-sidebar}}{{#html-after}}
		<div class="ak-menusidebar-after" id="MenuSidebarAfter">{{{.}}}</div>
		{{/html-after}}{{/data-menu-sidebar}}
	</div>
</aside>
